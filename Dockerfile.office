FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends git python3 ca-certificates procps curl lsof && rm -rf /var/lib/apt/lists/*
RUN npm install -g @anthropic-ai/claude-code pnpm@9 opencode-ai @google/gemini-cli
WORKDIR /app
COPY . .
ARG LOCAL_MODELS=
ARG DEFAULT_BACKEND=claude
ARG WORKSPACE_LABEL=workspace
ENV NEXT_PUBLIC_LOCAL_MODELS=$LOCAL_MODELS NEXT_PUBLIC_DEFAULT_BACKEND=$DEFAULT_BACKEND NEXT_PUBLIC_WORKSPACE_LABEL=$WORKSPACE_LABEL
RUN pnpm install --frozen-lockfile
RUN pnpm --filter web build
RUN install -m 755 /app/local/local-agent /usr/local/bin/local-agent
RUN ln -s /home/node/.local/bin/agy /usr/local/bin/agy
RUN chown -R node:node /app
USER node
ENV NODE_ENV=production NO_OPEN=1 DISABLE_QUICK_CONNECT=1 WS_PORT=9090 WORKSPACE=/home/node/projects HOME=/home/node
WORKDIR /app/apps/gateway
CMD ["pnpm", "start"]
